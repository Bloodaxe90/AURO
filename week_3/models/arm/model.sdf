<?xml version="1.0" ?>
<sdf version="1.6">
<model name="two_links">
  <static>false</static>
  <link name="base_link">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <mass>1.0</mass>
      <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
    </inertial>
    <collision name="collision">
      <geometry><box><size>0.1 0.1 0.5</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.1 0.1 0.5</size></box></geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
<link name="link1">
  <pose>0.1 0 0 0 0 0</pose>
  <inertial>
    <mass>0.5</mass>
    <inertia>
      <ixx>0.01</ixx>
      <iyy>0.01</iyy>
      <izz>0.01</izz>
    </inertia>
  </inertial>
  <collision name="collision">
    <geometry><box><size>0.4 0.05 0.05</size></box></geometry>
    <pose>0.2 0 0 0 0 0</pose>
  </collision>
  <visual name="visual">
    <geometry><box><size>0.4 0.05 0.05</size></box></geometry>
    <pose>0.2 0 0 0 0 0</pose>
    <material>
       <ambient>1 0 0 1</ambient>
       <diffuse>1 0 0 1</diffuse>
    </material>
  </visual>
</link>

<link name="link2">
  <pose>0.5 0 0 0 0 0</pose>
  <inertial>
    <mass>0.3</mass>
    <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
  </inertial>
  <collision name="collision">
    <geometry><box><size>0.3 0.05 0.05</size></box></geometry>
    <pose>0.15 0 0 0 0 0</pose>
  </collision>
  <visual name="visual">
    <geometry><box><size>0.3 0.05 0.05</size></box></geometry>
    <pose>0.15 0 0 0 0 0</pose>
    <material>
       <ambient>0 1 0 1</ambient>
       <diffuse>0 1 0 1</diffuse>
    </material>
  </visual>
</link>
<joint name="joint1" type="revolute">
  <parent>base_link</parent>
  <child>link1</child>
  <pose>0 0 0.05 0 0 0</pose>
  <axis>
    <xyz>0 0 1</xyz>
    <limit>
      <lower>-1.57</lower>
      <upper>1.57</upper>
      <effort>10</effort>
      <velocity>1.0</velocity>
    </limit>
  </axis>
</joint>

<joint name="joint2" type="revolute">
  <parent>link1</parent>
  <child>link2</child>
  <axis>
    <xyz>0 0 1</xyz>
    <limit>
      <lower>-1.57</lower>
      <upper>1.57</upper>
      <effort>10</effort>
      <velocity>1.0</velocity>
    </limit>
  </axis>
</joint>

  <!-- 1. Embedded ros2_control block -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="joint1">
        <command_interface name="position"/>
        <command_interface name="effort">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="joint2">
        <command_interface name="position"/>
        <command_interface name="effort">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>

    <!-- 2. gz_ros2_control Plugin -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>week_3/config/controllers.yaml</parameters>
    </plugin>

</model>
</sdf>
